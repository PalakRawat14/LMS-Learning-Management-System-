# Environment
NODE_ENV=production

# Backend Server
PORT=5000

# Auth / Security
JWT_SECRET=replace-with-a-strong-random-secret-min-32-chars

# Database Configuration (PostgreSQL - Production)
DB_DIALECT=postgres
DB_HOST=your-postgres-host.render.com
DB_PORT=5432
DB_NAME=lms_db
DB_USER=lms_user
DB_PASSWORD=your-strong-password-here

# Client URL (CORS/socket)
CLIENT_URL=https://your-frontend-domain.com

# Email Configuration (Gmail App Password)
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASSWORD=your-app-password-here

# Frontend Overrides (rarely needed if dynamic detection works)
# VITE_API_URL=http://localhost:5000/api
# VITE_API_PORTS=5000,5001,5002
# VITE_API_PORT_RANGE=5000-5005
